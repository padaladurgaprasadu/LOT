# ==============================================================================
# LOT Autonomous Agentic AI Operating System (AIOS) Environment Configuration
# ==============================================================================

# Core Ports
PORT=3000
BACKEND_PORT=8000
LITELLM_PORT=4000
SEARXNG_PORT=8080
QDRANT_PORT=6333
REDIS_PORT=6379

# LiteLLM Gateway Master Admin Key
LITELLM_MASTER_KEY=sk-lot-master-admin-key-flagship-mesh
LITELLM_BASE_URL=http://localhost:4000

# 5 Pooled NVIDIA NIM Frontier API Keys (Round-Robin & Automatic Failover)
NVIDIA_NIM_API_KEY_1=nvapi-kimi-k3-pro-primary-pool-key-01
NVIDIA_NIM_API_KEY_2=nvapi-deepseek-v4-r1-swe-pool-key-02
NVIDIA_NIM_API_KEY_3=nvapi-mistral-large-dom-pool-key-03
NVIDIA_NIM_API_KEY_4=nvapi-glm-tool-terminal-pool-key-04
NVIDIA_NIM_API_KEY_5=nvapi-nemotron-ultra-embed-pool-key-05
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Open-Higgsfield Media Studio & Cloud GPU Compute
HIGGSFIELD_API_KEY=hf-cluster-flagship-gpu-media-key-2026
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# Qdrant 4096-Dimensional Vector & Graph Memory
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=lot-qdrant-secure-local-key
QDRANT_COLLECTION=lot_mem0_4096d

# Redis Rate Limiting & Semantic Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# SearXNG Zero-404 Verified Search Grounding
SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET=lot-searxng-secret-token-key-2026

# Monetization & Affiliate Attribution Tracking
LOT_AFFILIATE_TAG=?ref=LOT_AIOS_AFFILIATE
JLCPCB_AFFILIATE_URL=https://jlcpcb.com/?ref=LOT_AIOS_AFFILIATE
PCBWAY_AFFILIATE_URL=https://www.pcbway.com/?ref=LOT_AIOS_AFFILIATE
MOUSER_AFFILIATE_URL=https://www.mouser.com/?ref=LOT_AIOS_AFFILIATE
SWIGGY_CPA_TAG=?ref=LOT_AIOS_AFFILIATE
ZOMATO_CPA_TAG=?ref=LOT_AIOS_AFFILIATE

# BYOK Vault Pricing Tiers (USD)
LOT_BYOK_PRO_MONTHLY_USD=7
LOT_ULTRA_FLAGSHIP_MONTHLY_USD=24

# Node & Browser Runtime Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
