# ==============================================================================
# LOT-OS: Sovereign Multi-Agent Operating System - Environment Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development or configure these variables
# in your Vercel Project Settings (Settings -> Environment Variables).
#
# LOT-OS is engineered with a Zero-Key Sovereign Architecture:
# ALL external AI, memory, and grounding services have automatic, functional
# fallbacks. The system boots and operates fully without any API keys configured.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Provider AI Model Rotation (Free Tier Failover Pool)
# ------------------------------------------------------------------------------
# LOT-OS dynamically rotates requests across 4 high-speed free AI providers with
# sub-10ms circuit-breaker failover. If a provider rate-limits, errors, or lacks
# a key, the system immediately cascades to the next healthy provider.

# Tier 1: Groq Cloud (Ultra-low latency Llama-3.3-70B & 8B)
# Free Key URL: https://console.groq.com/keys
# Default Model: llama-3.3-70b-versatile
# Fallback: Fails over to OpenRouter Free tier within 10ms.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tier 2: OpenRouter Free Tier (Community models & free endpoints)
# Free Key URL: https://openrouter.ai/keys
# Default Model: meta-llama/llama-3.3-70b-instruct:free
# Fallback: Fails over to Google Gemini 1.5 Flash within 10ms.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Tier 3: Google Gemini API (High context window & multimodal reasoning)
# Free Key URL: https://aistudio.google.com/app/apikey
# Default Model: gemini-1.5-flash
# Fallback: Fails over to NVIDIA NIM within 10ms.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Tier 4: NVIDIA NIM (Nemotron Super 49B & Llama 3.3 70B Instruct)
# Free Key URL: https://build.nvidia.com/explore/discover (1000 free inference credits)
# Default Model: nvidia/llama-3.3-nemotron-super-49b-v1.5
# Alternate env aliases supported: NVIDIA_NIM_API_KEY, LOT_BACKEND_KEY
# Fallback: When ALL keys are absent or exhausted, the Sovereign Zero-Key Engine
# (`synthesizeSovereignFallback`) activates immediately, producing syntactically
# valid React/PCB code, KaTeX proofs, and autonomous action cards ("I need biryani").
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key_here
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here
LOT_BACKEND_KEY=nvapi-your_nvidia_nim_api_key_here

# Model override for code generation tasks (Optional)
# Default: nvidia/nemotron-3-nano-30b-a3b
LOT_CODE_MODEL=nvidia/nemotron-3-nano-30b-a3b

# ------------------------------------------------------------------------------
# 2. NVIDIA Optical Director & Image Generation
# ------------------------------------------------------------------------------
# 2-Stage Optical Director: Llama-3.3-70B prompt refiner + FLUX.1-dev photorealism.
# Key URL: Uses NVIDIA_API_KEY from above (https://build.nvidia.com/black-forest-labs/flux-1-dev)
# Fallback: If NVIDIA FLUX key is absent, automatically falls back to Pollinations
# Flux AI engine with zero configuration and zero API keys needed.

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Database & Pgvector Storage
# ------------------------------------------------------------------------------
# Provides persistent user authentication, session history, and dual-mode vector
# memory embeddings for agent recall.
# Project Dashboard: https://supabase.com/dashboard/project/_/settings/api

# Public Supabase project REST URL (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://hvthwecmcifvjewwlpqk.supabase.co

# Public Supabase anonymous client token (Safe for client-side queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here

# Administrative Service Role token (Server-only; privileged pgvector indexing)
# Fallback: If Supabase credentials are missing or unreachable, LOT-OS automatically
# falls back to `LocalVectorStore` (`lib/vectorMemory.ts`), using client-side
# localStorage and an in-memory cosine similarity search engine with zero downtime.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_token_here

# ------------------------------------------------------------------------------
# 4. Real-Time Web Grounding & Live Research APIs
# ------------------------------------------------------------------------------
# Enables live web page extraction, ArXiv paper querying, and Google News grounding.

# Jina Reader API (Optional)
# Dashboard: https://jina.ai/reader/
# Purpose: Deep markdown scraping of complex SPAs and live URLs.
# Fallback: Jina Reader provides generous free anonymous access without an API key.
# If rate limited, LOT-OS falls back to Google News RSS and ArXiv public API.
JINA_API_KEY=jina_your_optional_reader_key_here

# Perplexity Sonar MCP API (Optional)
# Dashboard: https://www.perplexity.ai/settings/api
# Fallback: Falls back to Jina Reader and Google News search feeds.
PERPLEXITY_API_KEY=pplx-your_optional_perplexity_key_here

# ------------------------------------------------------------------------------
# 5. Audio Transcription & Meeting Co-Pilot
# ------------------------------------------------------------------------------
# Server-side Whisper fallback API (Optional)
# Dashboard: https://platform.openai.com/api-keys
# Alternate alias: WHISPER_API_KEY
# Fallback: LOT-OS includes an in-browser Web Worker offloading engine powered by
# `@huggingface/transformers` (`workers/transcriptionWorker.ts`). When server keys
# are omitted, audio is transcribed entirely client-side using local WASM Whisper.
OPENAI_API_KEY=sk-proj-your_optional_openai_key_here
WHISPER_API_KEY=sk-proj-your_optional_whisper_key_here

# ------------------------------------------------------------------------------
# 6. Security, Cryptography & Session Tokens
# ------------------------------------------------------------------------------
# MUST be configured in production. Generate random 32+ character hex or base64 strings:
# Terminal command: openssl rand -base64 32

# HMAC SHA-256 signing secret for user authentication tokens and cookies
JWT_SECRET=lot_sovereign_jwt_secret_replace_with_32_char_minimum_random_key_here!

# AES-256-GCM symmetric master key for encrypting user credentials and sensitive state
ENCRYPTION_SECRET=lot_master_encryption_key_replace_with_32_char_random_hex_here!

# NextAuth session signing key
NEXTAUTH_SECRET=lot_nextauth_secret_replace_with_32_char_random_token_here!

# ------------------------------------------------------------------------------
# 7. Application URL & Runtime Environment
# ------------------------------------------------------------------------------
# Canonical application origin for CORS verification, OpenRouter referer headers,
# and OAuth redirects.
# Production: https://lot-ai.in
# Local Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://lot-ai.in

# Node.js execution environment ('development' | 'production' | 'test')
NODE_ENV=production

# ------------------------------------------------------------------------------
# 8. Admin Bootstrap Credentials (Optional / Seed Only)
# ------------------------------------------------------------------------------
# Optional credentials to automatically seed an initial super-admin account
# in local database instances during initial setup.
LOT_SEED_ADMIN_EMAIL=admin@lot-ai.in
LOT_SEED_ADMIN_PASSWORD=change_this_admin_password_in_production!
LOT_SEED_ADMIN_NAME=LOT Sovereign Administrator
